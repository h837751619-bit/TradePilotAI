# Optional Docker Compose overrides for local demonstration.
# Set TRADEPILOT_BIND=0.0.0.0 only when you intentionally need LAN access.
TRADEPILOT_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8080

# MySQL 8.4 persistence (passwords used in DATABASE_URL must be URL-safe;
# generate a long random alphanumeric value for production).
MYSQL_DATABASE=tradepilot
MYSQL_USER=tradepilot
MYSQL_PASSWORD=replace-with-a-long-random-alphanumeric-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-alphanumeric-secret

# The Docker demo defaults to the rules provider. To use Ollama on the host,
# set AI_PROVIDER=ollama and keep host.docker.internal reachable from Docker.
AI_PROVIDER=rules
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_TAG_TIMEOUT_SECONDS=90

# Optional local semantic retrieval. Hugging Face model weights are downloaded
# on first use; model licenses and compute requirements vary by model.
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional JSON array of additional profiles, for example:
# EMBEDDING_PROFILES_JSON=[{"id":"hf:potion-multilingual","provider":"huggingface","model":"minishlab/potion-multilingual-128M"}]
EMBEDDING_PROFILES_JSON=
QDRANT_COLLECTION=tradepilot_products
RAG_EXPLANATIONS_ENABLED=true

# Optional OpenAI-compatible API. The key is consumed only by the backend.
# Example-compatible services may require their own Base URL and model name.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_TIMEOUT_SECONDS=45

# Demo authentication is off by default. Set AUTH_ENABLED=true and provide
# AUTH_SECRET, AUTH_USERNAME, and AUTH_PASSWORD_HASH before exposing the app.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=admin
CORS_ORIGINS=http://localhost:8080
