APP_ENV=development
# Local development may use SQLite. Production/Docker uses MySQL 8.4; see
# the root .env.example and DEPLOYMENT.md for the persistent deployment setup.
DATABASE_URL=sqlite:///tradepilot.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_DOCS_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_TAG_TIMEOUT_SECONDS=90
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PROFILES_JSON=
# Example supported FastEmbed profile:
# EMBEDDING_PROFILES_JSON=[{"id":"hf:potion-multilingual","provider":"huggingface","model":"minishlab/potion-multilingual-128M"}]
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tradepilot_products
RAG_EXPLANATIONS_ENABLED=true
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Optional OpenAI-compatible chat completions endpoint.
# Keep the real API key in backend/.env or your deployment secret store only.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_TIMEOUT_SECONDS=45
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Do not commit real credentials.
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=approver
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=604800
